{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2021"],
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-core",
    "noEmit": false,
    "rootDir": "src/core"
  },
  "include": ["src/core/**/*.ts"]
}
