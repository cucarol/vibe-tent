{
  "name": "vibe-tent",
  "version": "0.1.0",
  "description": "Manage intent, context, permissions, and task delegation between users and coding agents with an Obsidian plugin and CLI.",
  "type": "module",
  "bin": {
    "tent": "./cli.mjs",
    "tent-service": "./service.mjs"
  },
  "files": [
    "cli.mjs",
    "service.mjs",
    "main.js",
    "manifest.json",
    "versions.json",
    "styles.css",
    "skills/",
    "scripts/okf-check.mjs",
    "vendor/okf-conformance/",
    "docs/SPEC.md",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "main": "desktop/dist/main/index.cjs",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "build:plugin": "node esbuild.config.mjs production",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:desktop:next": "node scripts/build-desktop.mjs",
    "dev": "node esbuild.config.mjs",
    "build:core": "tsc -p tsconfig.core.json",
    "typecheck:renderer-next": "tsc -p tsconfig.renderer-next.json --noEmit",
    "test": "node scripts/run-tests.mjs full",
    "test:fast": "node scripts/run-tests.mjs fast",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:acp-images": "node --test --import tsx test/acp-image-prompt.test.ts",
    "test:renderer-next": "node --test --import tsx test/desktop-renderer-next-foundation.test.ts",
    "test:grok-e2e": "node --test --import tsx test/grok-acp-live.e2e.ts",
    "test:foreground-e2e": "node --test --import tsx test/mainstream-acp-cli-live.e2e.ts",
    "typecheck": "tsc -noEmit",
    "security:audit": "npm audit --audit-level=high",
    "okf:check": "node scripts/okf-check.mjs",
    "okf:check:strict": "node scripts/okf-check.mjs --strict",
    "markdown:preview": "tsx src/markdown/preview-server.ts",
    "desktop:build": "npm run build && npm run build:desktop",
    "desktop:dev": "npm run desktop:build && electron .",
    "desktop:start": "electron .",
    "desktop:package": "node scripts/package-desktop.mjs",
    "check": "npm run typecheck && npm run build && npm run build:desktop && npm test && npm run okf:check",
    "prepack": "npm run check"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "agent",
    "coding-agents",
    "harness",
    "cli",
    "okf",
    "open-knowledge-format",
    "context-engineering"
  ],
  "license": "MIT",
  "author": "cucarol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cucarol/tent.git"
  },
  "bugs": {
    "url": "https://github.com/cucarol/tent/issues"
  },
  "homepage": "https://github.com/cucarol/tent#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.1",
    "obsidian": "^1.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.3"
  }
}
