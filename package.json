{
  "name": "vibe-tent",
  "version": "0.1.0",
  "description": "Coordinate durable Node context, role-owned tasks, Agent Connections, and reviewable deliveries with coding agents.",
  "type": "module",
  "bin": {
    "tent": "./cli.mjs",
    "tent-service": "./service.mjs"
  },
  "files": [
    "cli.mjs",
    "service.mjs",
    "manifest.json",
    "skills/",
    "scripts/okf-check.mjs",
    "vendor/okf-conformance/",
    "docs/SPEC.md",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:desktop:next": "node scripts/build-desktop.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "dev": "node esbuild.config.mjs",
    "build:core": "node scripts/build-core.mjs",
    "typecheck:renderer-next": "tsc -p tsconfig.renderer-next.json --noEmit",
    "test": "node --import tsx scripts/run-tests.ts full",
    "test:fast": "node --import tsx scripts/run-tests.ts fast",
    "test:integration": "node --import tsx scripts/run-tests.ts integration",
    "test:acp-images": "node --test --import tsx test/acp-image-prompt.test.ts",
    "test:renderer-next": "node --test --import tsx test/desktop-renderer-next-foundation.test.ts test/desktop-renderer-next-workspace-projections.test.ts test/desktop-renderer-next-focus-document.test.ts test/desktop-canvas-v5-adapter.test.ts test/desktop-canvas-v5-local-persistence.test.ts test/desktop-renderer-next-service-gateway-failclosed.test.ts test/desktop-renderer-next-production-bridge.test.ts test/desktop-renderer-next-collaboration-protocol.test.ts test/desktop-renderer-next-collaboration-surface.test.ts test/desktop-service-host-events.test.ts test/desktop-trust-boundary.test.ts test/desktop-inbox-seam.test.ts test/desktop-renderer-next-outline-reveal.test.ts test/desktop-renderer-next-layout.test.ts",
    "test:grok-e2e": "node --test --import tsx test/grok-acp-live.e2e.ts",
    "test:foreground-e2e": "node --test --import tsx test/mainstream-acp-cli-live.e2e.ts",
    "typecheck": "tsc -noEmit",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "okf:check": "node scripts/okf-check.mjs",
    "okf:check:strict": "node scripts/okf-check.mjs --strict",
    "markdown:preview": "tsx src/markdown/preview-server.ts",
    "desktop:build": "npm run build && npm run build:desktop",
    "desktop:dev": "npm run desktop:build && electron desktop",
    "desktop:start": "electron desktop",
    "desktop:package": "node scripts/package-desktop.mjs",
    "check": "npm run typecheck && npm run build && npm run build:desktop && npm test && npm run okf:check",
    "prepack": "npm run check"
  },
  "keywords": [
    "agent",
    "coding-agents",
    "harness",
    "cli",
    "okf",
    "open-knowledge-format",
    "context-engineering",
    "desktop"
  ],
  "license": "MIT",
  "author": "cucarol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cucarol/vibe-tent.git"
  },
  "bugs": {
    "url": "https://github.com/cucarol/vibe-tent/issues"
  },
  "homepage": "https://github.com/cucarol/vibe-tent#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@excalidraw/excalidraw": "^0.18.1",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/react": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.1",
    "mdast-util-from-markdown": "^2.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.5.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3"
  }
}
