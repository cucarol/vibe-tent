{
  "model": "claude-opus-4-6",
  "theme": "dark",
  "permissions": {
    "allow": ["Read", "Bash(git status)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
